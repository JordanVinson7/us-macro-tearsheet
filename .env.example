# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Polygon (rebranded "Massive" in late 2025; keys and endpoints unchanged).
POLYGON_API_KEY=pk_your_polygon_key_here

# FRED — free key from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_32_char_fred_key_here

# Resend — https://resend.com. On the free plan mail is only delivered to the
# address the Resend account itself was registered with.
RESEND_API_KEY=re_your_resend_key_here

# Destination inbox for the morning email.
EMAIL_TO=you@example.com

# Public GitHub Pages URL, used for the "view online" link in the email.
SITE_URL=https://your-github-username.github.io/us-macro-tearsheet
