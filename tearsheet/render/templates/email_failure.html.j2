{# Sent when the pipeline fails part-way through, so a silent failure is never
   mistaken for a quiet market. #}
<div style="margin:0;padding:0;background:#f4f7fa;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f4f7fa;padding:20px 0;">
<tr><td align="center">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="640" style="width:640px;max-width:100%;background:#ffffff;border:1px solid #e7e9ee;">
  <tr>
    <td style="padding:20px 24px 14px;border-bottom:2px solid #b3261e;">
      <div style="font-family:Georgia,serif;font-size:19px;font-weight:bold;color:#b3261e;">
        Tear-sheet run failed
      </div>
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#6b7280;padding-top:4px;">
        {{ run_date.strftime('%A %d %B %Y') }} · {{ generated_at.strftime('%H:%M %Z') }}
      </div>
    </td>
  </tr>
  <tr>
    <td style="padding:18px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#1c1e21;line-height:1.55;">
      <p style="margin:0 0 12px;">No sheet was published for this date. The error was:</p>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fdf6e6;border-left:3px solid #9a6a00;">
        <tr><td style="padding:12px 14px;font-family:Courier,monospace;font-size:12px;color:#1c1e21;word-break:break-word;">
          {{ error }}
        </td></tr>
      </table>

      {% if sections %}
      <p style="margin:16px 0 6px;font-weight:bold;">Section status</p>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="font-size:12px;border-collapse:collapse;">
        {% for name, status in sections.items() %}
        <tr>
          <td style="padding:4px 0;border-bottom:1px solid #e7e9ee;">{{ name }}</td>
          <td align="right" style="padding:4px 0;border-bottom:1px solid #e7e9ee;color:#6b7280;">{{ status }}</td>
        </tr>
        {% endfor %}
      </table>
      {% endif %}

      {% if warnings %}
      <p style="margin:16px 0 6px;font-weight:bold;">Warnings ({{ warnings | length }})</p>
      <div style="font-size:12px;color:#6b7280;line-height:1.5;">
        {% for warning in warnings[:12] %}<div style="padding:2px 0;">• {{ warning }}</div>{% endfor %}
      </div>
      {% endif %}
    </td>
  </tr>
</table>
</td></tr>
</table>
</div>
