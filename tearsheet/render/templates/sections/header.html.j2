{% from '_macros.html.j2' import change %}
{% set ctx = result.context %}

<div class="kpis">
  {% for kpi in ctx.kpis %}
  <div class="kpi">
    <div class="kpi__label">{{ kpi.label }}</div>
    <div class="kpi__value">{{ kpi.value | level }}{{ kpi.value_suffix }}</div>
    <div class="kpi__change">
      {% if kpi.change_suffix == 'bp' %}
        {{ change(kpi.change, 'bp', kpi.change_decimals) }}
      {% else %}
        {{ change(kpi.change, 'percent', kpi.change_decimals) }}
      {% endif %}
    </div>
  </div>
  {% endfor %}
</div>

<div class="flags">
  <h3 class="flags__title">What stood out</h3>
  {% if ctx.flags %}
    <ul>
      {% for flag in ctx.flags %}
        <li class="sev-{{ flag.severity }}">{{ flag.text }}</li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="flags__empty">
      Nothing met the configured thresholds — a quiet session. Moves are flagged
      above {{ ctx.zscore_threshold }} standard deviations, alongside 52-week
      extremes, moving-average crosses, curve transitions and large credit moves.
    </p>
  {% endif %}
  <p class="block__note">
    Generated by explicit rules, not by a language model.
    {% if ctx.flag_count > ctx.flags | length %}
      {{ ctx.flag_count }} rules fired; the {{ ctx.flags | length }} most significant are shown.
    {% endif %}
  </p>
</div>
