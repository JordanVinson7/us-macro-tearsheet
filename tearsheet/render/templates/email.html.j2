{# Email-safe HTML: tables for layout, inline styles only.

   No <style> block, no external stylesheet, no web font, no JavaScript and no
   charts. Outlook in particular strips or ignores most of those, and an email
   that renders as unstyled text is worse than a plain one designed for it.
   Everything the reader needs to decide whether to open the full sheet is in
   the body; the PDF is attached and the live page is one click away. #}
<div style="margin:0;padding:0;background:#f4f7fa;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f4f7fa;padding:20px 0;">
<tr><td align="center">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="640" style="width:640px;max-width:100%;background:#ffffff;border:1px solid #e7e9ee;">

  <tr>
    <td style="padding:20px 24px 14px;border-bottom:2px solid #14375f;">
      <div style="font-family:Georgia,serif;font-size:20px;font-weight:bold;color:#1c1e21;">
        {{ title }}
      </div>
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#6b7280;padding-top:4px;">
        {{ run_date.strftime('%A %d %B %Y') }} · prices as of {{ session.strftime('%d %b %Y') }} close
      </div>
    </td>
  </tr>

  <tr>
    <td style="padding:18px 24px 4px;">
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:bold;letter-spacing:1px;color:#6b7280;text-transform:uppercase;padding-bottom:8px;">
        Key figures
      </div>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="font-family:Arial,Helvetica,sans-serif;font-size:13px;border-collapse:collapse;">
        {% for kpi in kpis %}
        <tr>
          <td style="padding:6px 0;border-bottom:1px solid #e7e9ee;color:#1c1e21;">{{ kpi.label }}</td>
          <td align="right" style="padding:6px 0;border-bottom:1px solid #e7e9ee;color:#1c1e21;">
            {{ kpi.value_text }}
          </td>
          <td align="right" width="90" style="padding:6px 0;border-bottom:1px solid #e7e9ee;color:{{ kpi.colour }};">
            {{ kpi.change_text }}
          </td>
        </tr>
        {% endfor %}
      </table>
    </td>
  </tr>

  <tr>
    <td style="padding:18px 24px 4px;">
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:bold;letter-spacing:1px;color:#6b7280;text-transform:uppercase;padding-bottom:8px;">
        What stood out
      </div>
      {% if flags %}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f4f7fa;border-left:3px solid #14375f;">
          <tr><td style="padding:12px 14px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#1c1e21;line-height:1.55;">
            {% for flag in flags %}
              <div style="padding:3px 0;">• {{ flag.text }}</div>
            {% endfor %}
          </td></tr>
        </table>
      {% else %}
        <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#6b7280;">
          Nothing met the configured thresholds — a quiet session.
        </div>
      {% endif %}
    </td>
  </tr>

  <tr>
    <td style="padding:18px 24px 4px;">
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:bold;letter-spacing:1px;color:#6b7280;text-transform:uppercase;padding-bottom:8px;">
        Today
      </div>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="font-family:Arial,Helvetica,sans-serif;font-size:13px;border-collapse:collapse;">
        {% if releases %}
          {% for entry in releases %}
          <tr>
            <td style="padding:5px 0;border-bottom:1px solid #e7e9ee;color:#1c1e21;">{{ entry.name }}</td>
            <td align="right" style="padding:5px 0;border-bottom:1px solid #e7e9ee;color:#6b7280;">{{ entry.time or '—' }} ET</td>
          </tr>
          {% endfor %}
        {% else %}
          <tr><td style="padding:5px 0;color:#6b7280;">No major scheduled releases.</td></tr>
        {% endif %}
        {% if fomc %}
        <tr>
          <td style="padding:5px 0;border-top:1px solid #e7e9ee;color:#1c1e21;">Next FOMC decision</td>
          <td align="right" style="padding:5px 0;border-top:1px solid #e7e9ee;color:#6b7280;">
            {{ fomc.date.strftime('%d %b') }} ({{ days_to_fomc }}d)
          </td>
        </tr>
        {% endif %}
        {% if earnings_line %}
        <tr>
          <td colspan="2" style="padding:5px 0;color:#6b7280;">{{ earnings_line }}</td>
        </tr>
        {% endif %}
      </table>
    </td>
  </tr>

  <tr>
    <td style="padding:22px 24px;">
      {% if site_url %}
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr><td style="background:#14375f;padding:11px 22px;">
          <a href="{{ site_url }}" style="font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;color:#ffffff;text-decoration:none;">
            View the full tear-sheet →
          </a>
        </td></tr>
      </table>
      {% endif %}
      {# The attachment note must not depend on SITE_URL: the PDF is attached
         whether or not the site is published yet. #}
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#9aa1ab;{% if site_url %}padding-top:8px;{% endif %}">
        {{ chart_count }} charts across {{ section_count }} sections.
        {% if has_attachment %}The full sheet is attached as a PDF.{% endif %}
        {% if not site_url %}<br>Set SITE_URL to include a link to the live page.{% endif %}
      </div>
    </td>
  </tr>

  <tr>
    <td style="padding:14px 24px 20px;border-top:1px solid #e7e9ee;">
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#9aa1ab;line-height:1.5;">
        {{ disclaimer }}
        <br><br>
        Generated automatically {{ generated_at.strftime('%d %b %Y, %H:%M %Z') }}.
        {% if warning_count %}{{ warning_count }} warning(s) recorded — see the footer of the full sheet.{% endif %}
      </div>
    </td>
  </tr>

</table>
</td></tr>
</table>
</div>
